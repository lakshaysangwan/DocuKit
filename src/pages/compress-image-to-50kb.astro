---
import ToolPageLayout from '@/components/tool-page/ToolPageLayout.astro';
import CompressImageTool from '@/components/islands/compress-image/CompressImageTool';
import { getLandingBySlug } from '@/lib/landing-pages';

const tool = getLandingBySlug('compress-image-to-50kb')!;
---

<ToolPageLayout {tool}>
  <CompressImageTool client:idle initialTargetKb={50} initialFormat="jpeg" />
</ToolPageLayout>
