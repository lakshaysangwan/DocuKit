---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
---

<BaseLayout
  title="Privacy Policy — Docukit"
  description="Docukit privacy policy. Files are processed in your browser and not uploaded; View-Once Image uploads only an encrypted copy. No tracking, no ads."
  canonical="https://docukit.uk/privacy/"
>
  <Header />

  <main id="main-content" class="flex-1">
    <section class="privacy">
      <div class="privacy__container">
        <h1 class="privacy__title">Privacy Policy</h1>
        <p class="privacy__updated">Last updated: October 2026</p>

        <div class="privacy__section">
          <h2 class="privacy__heading">No File Uploads</h2>
          <p class="privacy__text">
            Every tool except View-Once Image works entirely in your browser:
            your files are processed on your device and are not uploaded. Lock
            Image, too, encrypts your image in your browser and saves the locked
            file straight to your device.
          </p>
        </div>

        <div class="privacy__section">
          <h2 class="privacy__heading">View-Once Feature</h2>
          <p class="privacy__text">
            View-Once Image is the only tool that sends your file to our server.
            The image is encrypted in your browser first, and only the encrypted
            image and the expiry you chose are uploaded. The decryption key is
            only in the link, after the #, which browsers never send to a server,
            so the server cannot decrypt what it stores. The encrypted image is
            deleted the first time the link is opened, or when the link expires
            if nobody opens it. Like any website, the server sees the IP address
            of whoever uploads or opens an image; Docukit's server code does not
            store it.
          </p>
        </div>

        <div class="privacy__section">
          <h2 class="privacy__heading">No Tracking</h2>
          <p class="privacy__text">
            Docukit's code sets no cookies and includes no analytics or tracking
            scripts, and we do not collect personal data. Settings the site
            remembers, such as your theme or saved image sizes, stay in your browser's
            storage and are never sent anywhere.
          </p>
        </div>

        <div class="privacy__section">
          <h2 class="privacy__heading">No Ads</h2>
          <p class="privacy__text">
            Docukit does not display advertisements.
          </p>
        </div>

        <div class="privacy__section">
          <h2 class="privacy__heading">Open Source</h2>
          <p class="privacy__text">
            Docukit is open source. You can review all code at
            <a
              href="https://github.com/lakshaysangwan/DocuKit"
              target="_blank"
              rel="noopener noreferrer"
              class="privacy__link"
            >
              github.com/lakshaysangwan/DocuKit</a
            >.
          </p>
        </div>

        <div class="privacy__section">
          <h2 class="privacy__heading">Contact</h2>
          <p class="privacy__text">
            For privacy concerns, open an issue on
            <a
              href="https://github.com/lakshaysangwan/DocuKit/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="privacy__link"
            >
              GitHub</a
            >.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .privacy {
    padding: 3rem 1.5rem 4rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .privacy__container {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .privacy__title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .privacy__updated {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .privacy__section {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .privacy__section:last-child {
    border-bottom: none;
  }

  .privacy__heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .privacy__text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .privacy__link {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .privacy__link:hover {
    color: var(--color-primary-dark);
  }
</style>
