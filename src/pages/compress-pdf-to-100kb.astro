import CompressPdfTool from '@/components/islands/compress-pdf/CompressPdfTool';
import { getLandingBySlug } from '@/lib/landing-pages';

const tool = getLandingBySlug('compress-pdf-to-100kb')!;
---

<ToolPageLayout {tool}>
