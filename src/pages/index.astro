---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import TrustBanner from '@/components/layout/TrustBanner.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import ToolGrid from '@/components/home/ToolGrid.astro';
import { TOOLS } from '@/lib/tools-registry';

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Docukit',
  url: 'https://docukit.uk/',
  description: 'Browser-based PDF and image tools. No uploads, no accounts.',
});

// Ties the brand name to this site for Google's knowledge panel / site name.
const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Docukit',
  url: 'https://docukit.uk/',
  logo: 'https://docukit.uk/favicon.svg',
  sameAs: ['https://github.com/lakshaysangwan/DocuKit'],
});
---

<BaseLayout
  title="Docukit — PDF & Image Tools in Your Browser"
  description="Browser-based PDF and image tools. Merge, split, compress, sign, watermark, convert, and more. No uploads, no accounts, no limits."
  canonical="https://docukit.uk/"
>
  <script type="application/ld+json" set:html={websiteSchema} slot="head" />
  <script type="application/ld+json" set:html={organizationSchema} slot="head" />

  <TrustBanner />
  <Header />

  <main id="main-content" class="flex-1">
    <Hero />
    <ToolGrid tools={TOOLS} />
  </main>

  <Footer />
</BaseLayout>
