---
// Hero section — left-aligned, bold, minimal
---

<section class="px-4 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-20">
  <div class="mx-auto max-w-6xl">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-6xl md:text-7xl" style="letter-spacing: -0.03em; line-height: 1.05;">
      PDF & Image tools.<br />
      In your browser.
    </h1>

    <p class="mt-6 max-w-lg text-base text-[var(--color-text-secondary)] sm:text-lg" style="line-height: 1.6;">
      No uploads. No accounts. Files never leave your device.
    </p>

    <div class="mt-8 flex items-center gap-3">
      <a
        href="#tools"
        class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-text-primary)] px-5 py-2.5 text-sm font-medium text-[var(--color-background)] transition-opacity hover:opacity-80"
      >
        Browse tools
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a
        href="/privacy"
        class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2.5 text-sm font-medium text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
      >
        How it works
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
