---
import type { ToolDef } from '@/lib/tools-registry';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  tool: ToolDef;
  featured?: boolean;
}
const { tool, featured = false } = Astro.props;

const isPdf = tool.category === 'pdf';
const accentColor = isPdf ? 'var(--color-pdf)' : 'var(--color-image)';
const accentBg = isPdf ? 'var(--color-pdf-bg)' : 'var(--color-image-bg)';

// Inline SVG at build time for proper currentColor support
let svgContent = '';
try {
  const svgPath = path.join(process.cwd(), 'public', tool.icon);
  svgContent = fs.readFileSync(svgPath, 'utf-8');
  // Strip width/height from SVG root so we control size via CSS
  svgContent = svgContent.replace(/\s*width="24"\s*/g, ' ').replace(/\s*height="24"\s*/g, ' ');
} catch {
  // Fallback: no icon
}
---

<a
  href={`/${tool.slug}`}
  class:list={[
    "group relative flex flex-col gap-4 border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-150",
    "hover:border-transparent hover:shadow-[var(--shadow-card-hover)]",
    featured ? "rounded-xl p-5 sm:p-6" : "rounded-lg p-5",
  ]}
  aria-label={`${tool.name} — ${tool.shortDescription}`}
>
  <!-- Accent left border on hover -->
  <div
    class="absolute left-0 top-3 bottom-3 w-0.5 rounded-full opacity-0 transition-opacity duration-150 group-hover:opacity-100"
    style={`background: ${accentColor};`}
    aria-hidden="true"
  />

  <!-- Icon — inlined SVG -->
  <div
    class:list={[
      "flex items-center justify-center rounded-lg",
      featured ? "h-11 w-11" : "h-10 w-10",
    ]}
    style={`background: ${accentBg}; color: ${accentColor};`}
  >
    {svgContent ? (
      <div class:list={[featured ? "h-5 w-5" : "h-[18px] w-[18px]", "[&>svg]:h-full [&>svg]:w-full"]} set:html={svgContent} />
    ) : (
      <div class={featured ? "h-5 w-5" : "h-[18px] w-[18px]"} />
    )}
  </div>

  <!-- Text -->
  <div>
    <h3 class:list={[
      "font-semibold text-[var(--color-text-primary)]",
      featured ? "text-base" : "text-[15px]",
    ]}>
      {tool.name}
    </h3>
    <p class:list={[
      "mt-1 text-[var(--color-text-muted)] leading-snug",
      featured ? "text-sm" : "text-[13px]",
    ]}>
      {tool.shortDescription}
    </p>
  </div>
</a>
