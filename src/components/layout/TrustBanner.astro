---
// Minimal trust banner
---
<div
  class="border-b border-[var(--color-border)] px-4 py-1.5 text-center"
  role="banner"
  aria-label="Privacy notice"
>
  <span class="text-xs text-[var(--color-text-muted)]">
    All processing happens locally in your browser.
    <a
      href="/privacy"
      class="ml-1 text-[var(--color-text-secondary)] underline underline-offset-2 hover:text-[var(--color-text-primary)]"
    >
      Learn more
    </a>
  </span>
</div>
