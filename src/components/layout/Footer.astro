---
import { PDF_TOOLS, IMAGE_TOOLS } from '@/lib/tools-registry';
---

<footer class="mt-auto border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <!-- PDF Tools -->
      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">PDF</h3>
        <ul class="mt-3 space-y-1.5">
          {PDF_TOOLS.slice(0, 8).map(tool => (
            <li>
              <a
                href={`/${tool.slug}`}
                class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- More PDF -->
      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">More PDF</h3>
        <ul class="mt-3 space-y-1.5">
          {PDF_TOOLS.slice(8).map(tool => (
            <li>
              <a
                href={`/${tool.slug}`}
                class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Image Tools -->
      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">Image</h3>
        <ul class="mt-3 space-y-1.5">
          {IMAGE_TOOLS.map(tool => (
            <li>
              <a
                href={`/${tool.slug}`}
                class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">Links</h3>
        <ul class="mt-3 space-y-1.5">
          <li>
            <a href="/privacy" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]">Privacy</a>
          </li>
          <li>
            <a
              href="https://github.com/lakshaysangwan/DocuKit"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]"
            >
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-[var(--color-border)] pt-6">
      <p class="text-xs text-[var(--color-text-muted)]">
        &copy; {new Date().getFullYear()} Docukit. Files are processed locally and never uploaded.
      </p>
    </div>
  </div>
</footer>
