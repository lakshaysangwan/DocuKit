---
interface Props {
  headline: string;
  description: string;
  category?: 'pdf' | 'image';
}
const { headline, description, category = 'pdf' } = Astro.props;
const isPdf = category === 'pdf';
---

<div class="px-4 pb-6 pt-10 sm:px-6 sm:pt-14">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center gap-2 mb-4">
      <div
        class="h-1.5 w-1.5 rounded-full"
        style={`background: ${isPdf ? 'var(--color-pdf)' : 'var(--color-image)'};`}
        aria-hidden="true"
      />
      <span class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">
        {isPdf ? 'PDF' : 'Image'} Tool
      </span>
    </div>

    <h1 class="text-2xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-3xl" style="letter-spacing: -0.02em;">
      {headline}
    </h1>

    <p class="mt-2 max-w-xl text-sm text-[var(--color-text-secondary)] sm:text-base" style="line-height: 1.6;">
      {description}
    </p>
  </div>
</div>
