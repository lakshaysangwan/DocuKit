# Cloudflare Pages reads this file from the build output, so it must live in
# public/ — a _headers file at the repo root is never deployed.

/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' blob: data:; media-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Content-hashed filenames — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# /fonts, /wasm and /pdfjs are NOT content-hashed, so they keep Cloudflare's
# default revalidation: an immutable cache there would pin returning visitors to
# a stale pdf.js worker after an upgrade.
